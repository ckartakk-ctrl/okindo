# Bu dosyanın adını .env yap ve iki değeri Supabase panelinden doldur:
# Supabase > Project Settings > API
EXPO_PUBLIC_SUPABASE_URL=https://PROJE-KODUN.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=buraya-anon-public-anahtar

# İsteğe bağlı: hata takibi. Sentry'de React Native projesi açınca verilen DSN adresi (gizli değildir).
EXPO_PUBLIC_SENTRY_DSN=

# DİKKAT: service_role anahtarını ve ödeme anahtarlarını ASLA buraya yazma.
# Onlar yalnız Supabase Edge Function ayarlarına (secrets) girer.
